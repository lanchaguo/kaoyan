.container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 目标信息栏 */
.target-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #394867 100%);
  color: #fff;
}

.target-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.target-label {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.target-school {
  font-size: 28rpx;
  font-weight: bold;
}

.target-major {
  font-size: 24rpx;
  opacity: 0.9;
}

.target-arrow {
  font-size: 28rpx;
  opacity: 0.7;
}

.banner {
  height: 350rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 20rpx;
  left: 30rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.category {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #1a1a2e;
}

.article-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-item:last-child {
  border-bottom: none;
}

.article-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.article-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

/* 考试科目标题 */
.subject-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.subject-header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.subject-header-tip {
  font-size: 24rpx;
  color: #999;
}

/* 学科切换 */
.subject-tabs {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  transition: all 0.3s;
  border: 2rpx solid #e0e0e0;
  position: relative;
}

.tab-item.active {
  border-color: var(--active-color);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 选中角标 */
.tab-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--active-color);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

.tab-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--active-color);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 24rpx;
  color: #666;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 题目列表 */
.question-list {
  margin-top: 20rpx;
}

.question-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #1a1a2e;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.question-type {
  font-size: 24rpx;
  color: #666;
  background: #e9ecef;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.question-diff {
  font-size: 24rpx;
  font-weight: bold;
}

.question-stem {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.question-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.load-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.load-more text {
  color: #1a1a2e;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 16rpx;
}
